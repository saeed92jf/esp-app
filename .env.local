# .env.local
WATCHPACK_POLLING=true

# .env.local.example
# ─────────────────────────────────────────────────────────────────────────────
# این فایل را کپی کن به .env.local و مقادیر را بر اساس محیط تنظیم کن.
# .env.local هرگز نباید commit شود (در .gitignore هست).

# ── حالت API ────────────────────────────────────────────────────────────────
# fake = داده‌های mock محلی (پیش‌فرض، برای توسعه بدون بک‌اند)
# real = اتصال واقعی به سرور
NEXT_PUBLIC_API_MODE=real

# ── آدرس پایه API فرانت‌اند ──────────────────────────────────────────────────
# کلاینت فرانت‌اند درخواست‌ها را به پراکسی Next.js ارسال می‌کند (/api/real)
NEXT_PUBLIC_API_BASE_URL=/api/real

# ── آدرس سرویس بک‌اند (FastAPI در لوکال - ESP-Web-Backend) ────────────────────
# پورت پیش‌فرض سرویس در لوکال طبق .env.dev و docker-compose.dev.yml برابر 8080 است.
BACKEND_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080/api/v1

# ── Aparat (بدون تغییر، در هر دو حالت استفاده می‌شود) ─────────────────────────
NEXT_PUBLIC_APARAT_USERNAMES=Euroslot_Pars

# ── Finnhub (crypto real-time data)
FINNHUB_API_KEY=datofo1r01quegbh1lqgdatofo1r01quegbh1lr0
